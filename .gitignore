# Local persistence — ephemeral, never commit (use DATABASE_URL/Postgres in cloud)
outputs/forecast_workbench/validation/model_runs.db
**/__pycache__/
*.pyc
.DS_Store

# Streamlit secrets — never commit real credentials
outputs/forecast_workbench/.streamlit/secrets.toml

# Jupyter checkpoint copies — editor scratch, regenerated on every save
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Claude Code audit log and its HMAC signing key — local session transcripts,
# no business being in a public repository
.audit-key
audit.jsonl
